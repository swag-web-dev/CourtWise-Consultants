# Local development — copy to .env and fill in values
# On Render, DATABASE_URL is set automatically from the linked database.

DATABASE_URL=

# Individual vars (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=courtwise_cms

JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=8h
